# Where the same-origin proxy (server/routes/backend/[...path].ts) forwards /backend/** requests.
# Leave empty to have newsletter sign-ups answer "service unavailable" honestly instead of faking success.
NUXT_API_PROXY_TARGET=

# Placeholder testimonial cards ("Testimonial pending"). Defaults to true in dev, false in production builds.
# Never set this to true for a production deploy (brief §07: do not publish with placeholder text).
NUXT_PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS=
