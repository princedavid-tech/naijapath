{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vue", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-cycle": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": [".nuxt/**", ".nuxt-*/**", ".output/**", "node_modules/**", "public/**"]
}
